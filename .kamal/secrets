# Kamal secrets — SAFE TO COMMIT.
# This file only *references* environment variables; it contains NO literal
# credentials. Kamal reads the named env vars from your shell at deploy time.
#
# Provide these in your shell before running `kamal deploy` locally, e.g.:
#   export KAMAL_REGISTRY_PASSWORD="$(gh auth token)"   # ghcr token w/ write:packages
#   export API_KEY="<long-random-string>"               # or leave unset to disable
#
# In CI (GitHub Actions) the registry password comes from GITHUB_TOKEN and
# API_KEY from a repo secret.
#
# Required / optional env vars:
#   KAMAL_REGISTRY_PASSWORD  (required) ghcr.io token with write:packages
#   API_KEY                  (optional) bypass token for the public text cap +
#                                       generous rate limit; unset = disabled

KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
API_KEY=$API_KEY
